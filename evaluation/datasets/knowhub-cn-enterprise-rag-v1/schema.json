{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KnowHub CN Enterprise RAG Gold Case",
  "type": "object",
  "required": [
    "question_id",
    "split",
    "question_type",
    "difficulty",
    "question",
    "expected_doc_ids",
    "gold_answer",
    "answer_facts",
    "allowed_execution_modes",
    "should_abstain",
    "should_clarify"
  ],
  "properties": {
    "question_id": {"type": "string", "pattern": "^KH-[A-Z]+-[0-9]{3}$"},
    "split": {"enum": ["smoke", "regression", "challenge"]},
    "question_type": {"type": "string"},
    "difficulty": {"enum": ["easy", "medium", "hard"]},
    "source_types": {"type": "array", "items": {"type": "string"}},
    "question": {"type": "string", "minLength": 2},
    "conversation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string"}
        }
      }
    },
    "chat_mode": {"enum": ["DOCUMENT", "AUTO_DOCUMENT", "OPEN_CHAT"]},
    "selected_document_key": {"type": ["string", "null"]},
    "expected_doc_ids": {"type": "array", "items": {"type": "string"}},
    "gold_answer": {"type": "string"},
    "answer_facts": {"type": "array", "items": {"type": "string"}},
    "gold_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["doc_id", "section_path", "text_anchor"],
        "properties": {
          "doc_id": {"type": "string"},
          "section_path": {"type": "string"},
          "text_anchor": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "allowed_execution_modes": {
      "type": "array",
      "items": {"enum": ["GRAPH_ONLY", "GRAPH_THEN_EVIDENCE", "RETRIEVAL", "REACT_AGENT", "CLARIFICATION"]}
    },
    "should_abstain": {"type": "boolean"},
    "should_clarify": {"type": "boolean"},
    "citation_required": {"type": "boolean"},
    "forbidden_claims": {"type": "array", "items": {"type": "string"}},
    "tags": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
